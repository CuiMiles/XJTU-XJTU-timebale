<view class="heading" style="padding-top:{{navTop}}px;padding-right:{{navRight}}px;">
  <view class="heading-main">
    <picker range="{{weeks}}" value="{{week - 1}}" bindchange="pick">
      <view class="week">第{{week}}周<text class="week-status {{isCurrentWeek ? 'current' : ''}}">{{isCurrentWeek ? '本周' : '非本周'}}</text><text class="chevron">⌄</text></view>
    </picker>
    <view class="heading-actions">
      <view class="heading-action" aria-label="回到本周" bindtap="current">今</view>
      <view class="heading-action" aria-label="课表导入" bindtap="import">导</view>
      <view class="heading-action" aria-label="管理课程" bindtap="manage">管</view>
    </view>
  </view>
  <view class="subdate">{{selectedDate}} · 周{{selectedDayName}}</view>
</view>

<view wx:if="{{loadError}}" class="load-error"><view>本地课表读取失败，原数据未覆盖。</view><button bindtap="manage">打开管理</button></view>
<swiper wx:else class="week-swiper" current="{{swipeIndex}}" duration="{{swiperDuration}}" bindchange="swipeChange">
  <swiper-item wx:for="{{frames}}" wx:for-item="frame" wx:key="slot">
    <view class="week-page">
      <view class="dayhead">
        <view class="axis month" bindtap="current">{{frame.month}}</view>
        <view wx:for="{{frame.days}}" wx:for-item="day" wx:for-index="dayIndex" wx:key="date" class="day {{day.today ? 'day-today' : ''}} {{day.selected ? 'day-selected' : ''}}" data-day="{{dayIndex + 1}}" bindtap="selectDay">
          <view class="weekday">{{day.name}}</view><view class="date">{{day.label}}</view>
          <view wx:if="{{day.holiday || day.monthHint}}" class="day-hint">{{day.holiday ? '休' : day.monthHint}}</view>
        </view>
      </view>
      <scroll-view scroll-y class="grid-scroll">
        <view class="grid" style="height:{{frame.gridHeight}}rpx;">
          <view wx:for="{{frame.rows}}" wx:for-item="row" wx:key="n" class="grid-row" style="height:{{frame.rowHeight}}rpx;">
            <view class="axis"><view class="section">{{row.n}}</view><view class="section-time">{{row.start}}</view><view class="section-time">{{row.end}}</view></view>
            <view wx:for="{{frame.days}}" wx:for-item="day" wx:key="date" class="cell {{day.today ? 'today-lane' : ''}}"></view>
          </view>
          <view class="courses">
            <view wx:for="{{frame.cards}}" wx:for-item="card" wx:for-index="cardIndex" wx:key="key" class="card" style="top:{{card.top}}rpx;height:{{card.height}}rpx;left:{{card.day * 100 / 7}}%;width:14.285714%;" data-index="{{cardIndex}}" data-week="{{frame.week}}" bindtap="open" aria-label="{{card.name}}，第{{card.sectionText}}节，{{card.room}}">
              <view class="card-inner" style="background:linear-gradient(165deg,{{card.theme.background}},{{card.theme.end}});color:{{card.theme.text}};">
                <view class="course-name">{{card.shortName}}</view><view class="room" style="color:{{card.theme.secondary}};">{{card.shortRoom}}</view>
                <view wx:if="{{card.conflicts > 1}}" class="badge">重叠</view><view wx:elif="{{card.o.adjusted}}" class="badge">已调</view>
              </view>
            </view>
          </view>
          <view wx:if="{{frame.nowTop >= 0}}" class="time-line" style="top:{{frame.nowTop}}rpx;"><view class="time-dot"></view></view>
          <view wx:if="{{empty}}" class="empty-tools"><view class="empty-title">还没有课程</view><view class="empty-buttons"><button class="primary" bindtap="import">导入课表</button><button bindtap="add">手动添加</button></view><view class="empty-caption">教务系统导入入口已预留</view></view>
          <view wx:elif="{{frame.noClasses}}" class="quiet-empty">本周无课</view>
        </view>
      </scroll-view>
    </view>
  </swiper-item>
</swiper>

<view wx:if="{{selection.length}}" class="mask" bindtap="close">
  <view class="sheet" catchtap="noop"><view class="title">这个时段的课程</view>
    <view wx:for="{{selection}}" wx:key="key" class="line" data-index="{{index}}" bindtap="choose">{{item.name}} · {{item.room}}<view class="muted">第 {{item.sectionText}} 节</view></view>
    <button bindtap="close">关闭</button>
  </view>
</view>

<view wx:if="{{detail}}" class="mask" bindtap="closeDetail">
  <view class="sheet" catchtap="noop"><view class="muted">课程详情 {{detail.adjusted ? '· 已调整' : ''}}</view><view class="title">{{detail.course.name}}</view>
    <view class="line">{{detail.date}} · 星期{{detail.day}} · 第 {{detail.sectionText}} 节</view>
    <view class="line">时间　{{detail.time}}</view><view class="line">教室　{{detail.room || '待定'}}</view>
    <view class="line">班级　{{detail.course.className || '未填写'}}</view><view class="line">教师　{{detail.teachers || '未填写'}}</view>
    <view wx:if="{{detail.parts.length === 1}}" class="line">周次　第 {{detail.weeks}} 周</view>
    <view wx:else class="line"><view wx:for="{{detail.parts}}" wx:key="id">{{item.sections}}节 · 第{{item.weeks}}周</view></view>
    <view wx:if="{{detail.course.note}}" class="line">备注　{{detail.course.note}}</view>
    <button class="primary" bindtap="adjustDetail">调整本次 / 恢复原安排</button>
    <view wx:if="{{showParts}}" class="adjust-parts"><view class="muted">选择要调整的课段</view><button wx:for="{{detail.parts}}" wx:key="id" data-index="{{index}}" bindtap="adjustPart">第{{item.sections}}节</button></view>
    <button bindtap="closeDetail">关闭</button>
  </view>
</view>

<view class="heading"
  ><view class="row"
    ><view
      ><view class="brand">小交课表 <text class="season">2026 秋</text></view
      ><view class="muted">{{todayLabel}} · 给每一天，留一点从容</view></view
    ><text class="today" bindtap="current">{{status}}</text></view
  ><view class="weekbar"
    ><button bindtap="prev" disabled="{{week === 1}}">‹</button
    ><picker range="{{weeks}}" value="{{week - 1}}" bindchange="pick"
      ><view class="week"
        >第 {{week}} 周
        <text class="muted">{{week > 16 ? '考试周' : '教学周'}} ▾</text></view
      ></picker
    ><button bindtap="next" disabled="{{week === 18}}">›</button></view
  ></view
>
<view wx:if="{{loadError}}" class="page"
  ><view class="notice"
    >本地数据读取失败。原数据未覆盖，可在管理页导出原始数据或恢复备份。</view
  ><button bindtap="manage">前往管理</button></view
>
<view wx:elif="{{empty}}" class="empty"
  ><view class="empty-art">▦</view><view class="title">把新学期，装进口袋</view
  ><view class="muted"
    >导入你的课表，或从第一门课开始。<br />数据只保存在这台设备，无需登录。</view
  ><button class="primary" bindtap="import">导入课表</button
  ><button bindtap="add">手动添加</button
  ><view class="muted">学生个人工具 · 非西安交通大学官方产品</view></view
>
<block wx:else
  ><view class="dayhead"
    ><view class="axis">节次</view
    ><view
      wx:for="{{days}}"
      wx:key="date"
      class="day {{item.today ? 'active' : ''}}"
      ><view>{{item.name}}</view><view class="date">{{item.label}}</view
      ><text wx:if="{{item.holiday}}" class="holiday">停课</text></view
    ></view
  ><view wx:if="{{noClasses}}" class="week-empty"
    >这一周没有安排，享受自由时光 ☁</view
  ><scroll-view scroll-y class="grid-scroll"
    ><view class="grid"
      ><view wx:for="{{rows}}" wx:key="n" class="grid-row"
        ><view class="axis"
          ><view class="section">{{item.n}}</view><view>{{item.start}}</view
          ><view>{{item.end}}</view></view
        ><view wx:for="{{days}}" wx:key="date" class="cell" /></view
      ><view class="courses"
        ><view
          wx:for="{{cards}}"
          wx:key="key"
          class="card"
          style="top:{{item.top}}rpx;height:{{item.height}}rpx;left:{{item.day * 100 / 7}}%;width:14.285714%;"
          data-index="{{index}}"
          bindtap="open"
          ><view class="card-inner {{item.height === 110 ? 'tight' : ''}}" style="background:{{item.color}}"
            ><view class="course-name">{{item.name}}</view
            ><view class="room">{{item.room || '教室待定'}}</view
            ><view class="badge" wx:if="{{item.conflicts > 1}}"
              >重叠 · 点开全部</view
            ><view class="badge" wx:elif="{{item.o.adjusted}}"
              >已调整</view
            ></view
          ></view
        ></view
      ></view
    ><view class="footnote"
      >{{week === 3 ? '10月1日起使用冬季作息，课程详情显示当天准确时间。' :
      '点击课程查看详情 · 重叠课程点击后可逐一查看'}}<br />个人课表 ·
      非官方产品</view
    ></scroll-view
  ></block
>
<view wx:if="{{selection.length}}" class="mask" bindtap="close"
  ><view class="sheet" catchtap="noop"
    ><view class="title">这个时段的课程</view
    ><view class="muted">存在时间重叠，请选择要查看的课程</view
    ><view
      wx:for="{{selection}}"
      wx:key="key"
      class="line"
      data-index="{{index}}"
      bindtap="choose"
      >{{item.name}} · {{item.room}}<view class="muted"
        >第 {{item.o.sections}} 节</view
      ></view
    ><button bindtap="close">关闭</button></view
  ></view
>

<view wx:if="{{detail}}" class="mask" bindtap="closeDetail"
  ><view class="sheet" catchtap="noop"
    ><view class="muted">课程详情 {{detail.adjusted ? '· 已调整' : ''}}</view
    ><view class="title">{{detail.course.name}}</view
    ><view class="line"
      >{{detail.date}} · 星期{{detail.day}} · 第 {{detail.sections}} 节</view
    ><view class="line">时间　{{detail.time}}</view
    ><view class="line">教室　{{detail.room || '待定'}}</view
    ><view class="line">班级　{{detail.course.className || '未填写'}}</view
    ><view class="line"
      >教师　{{detail.course.teachers.length ? detail.course.teachers :
      '未填写'}}</view
    ><view class="line">周次　第 {{detail.weeks}} 周</view
    ><view wx:if="{{detail.course.note}}" class="line"
      >备注　{{detail.course.note}}</view
    ><button class="primary" bindtap="adjustDetail">
      调整本次 / 恢复原安排</button
    ><button bindtap="closeDetail">关闭</button></view
  ></view
>

page {
  height: 100%;
  display: flex;
  flex-direction: column;
}
.heading {
  padding: 12rpx 20rpx;
  background: #f7f9fc;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
}
.week-summary {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.week {
  font-size: 32rpx;
  font-weight: 600;
  white-space: nowrap;
}
.chevron {
  font-size: 20rpx;
  color: #8193a4;
}
.today {
  font-size: 23rpx;
  color: #718393;
}
.week-controls {
  display: flex;
}
.week-controls button {
  width: 60rpx;
  height: 64rpx;
  padding: 0;
  margin: 0;
  font-size: 38rpx;
  line-height: 60rpx;
  background: transparent;
}
.schedule {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}
.month {
  font-size: 23rpx;
  align-self: center;
  color: #53697a;
}
.dayhead {
  display: flex;
  background: #fff;
  padding: 16rpx 0;
  min-height: 106rpx;
}
.axis {
  width: 64rpx;
  flex-shrink: 0;
  text-align: center;
  font-size: 17rpx;
  color: #98a3ad;
}
.day {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
}
.date {
  font-size: 21rpx;
  color: #8b99a7;
  margin-top: 6rpx;
}
.active {
  color: #2e709f;
  font-weight: bold;
}
.active .date {
  color: #2e709f;
}
.holiday {
  font-size: 17rpx;
  color: #b48b54;
}
.grid-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}
.grid {
  position: relative;
  height: 1276rpx;
  background: #fff;
}
.grid-row {
  height: 116rpx;
  display: flex;
}
.grid-row .axis {
  padding-top: 16rpx;
}
.section {
  font-size: 26rpx;
  color: #718393;
  margin-bottom: 2rpx;
}
.cell {
  flex: 1;
  border-top: 1rpx solid #f0f3f6;
  border-left: 1rpx solid #f6f8fa;
}
.courses {
  position: absolute;
  left: 64rpx;
  right: 0;
  top: 0;
}
.card {
  position: absolute;
  padding: 3rpx;
}
.card-inner {
  height: 100%;
  border-radius: 12rpx;
  padding: 11rpx 6rpx;
  overflow: hidden;
  color: #365063;
}
.course-name {
  font-size: 23rpx;
  line-height: 1.35;
  font-weight: 600;
  word-break: break-all;
}
.room {
  font-size: 20rpx;
  line-height: 1.4;
  margin-top: 9rpx;
  word-break: break-all;
}
.badge {
  font-size: 17rpx;
  margin-top: 6rpx;
  color: #586a79;
}
.footnote {
  text-align: center;
  font-size: 21rpx;
  line-height: 1.8;
  color: #97a3ae;
  padding: 24rpx;
}
.week-empty {
  text-align: center;
  padding: 14rpx;
  font-size: 23rpx;
  color: #879baa;
}
.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(28, 45, 60, 0.28);
  z-index: 10;
  display: flex;
  align-items: flex-end;
}
.sheet {
  background: white;
  border-radius: 30rpx 30rpx 0 0;
  padding: 32rpx;
  width: 100%;
  max-height: 75vh;
  overflow-y: auto;
  padding-bottom: 60rpx;
}

.course-name {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}
.tight .course-name {
  -webkit-line-clamp: 1;
}
.room {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tight .room {
  margin-top: 5rpx;
}
.tight .badge {
  margin-top: 3rpx;
  font-size: 16rpx;
}

/* 相邻的同课数据条目连接外观，仍保留各自的点击和调课身份。 */
.join-before {
  padding-top: 0;
}
.join-after {
  padding-bottom: 0;
}
.join-before .card-inner {
  border-top-left-radius: 0;
  border-top-right-radius: 0;
}
.join-after .card-inner {
  border-bottom-left-radius: 0;
  border-bottom-right-radius: 0;
}

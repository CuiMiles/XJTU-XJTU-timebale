page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #fcfcfa;
  color: #34423e;
}
.heading {
  padding: 0 24rpx 16rpx;
  flex-shrink: 0;
  background: #fcfcfa;
}
.nav-row {
  display: flex;
  align-items: flex-start;
  box-sizing: border-box;
}
.week {
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: -1rpx;
  white-space: nowrap;
}
.chevron {
  font-size: 26rpx;
  color: #9ba49f;
  margin-left: 4rpx;
  font-weight: 400;
}
.semester-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 6rpx;
  gap: 10rpx;
}
.semester {
  font-size: 21rpx;
  color: #939b97;
  white-space: nowrap;
}
.week-status {
  font-size: 23rpx;
  font-weight: 400;
  color: #949e97;
  letter-spacing: 0;
}
.schedule {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}
.dayhead {
  display: flex;
  padding: 10rpx 0 8rpx;
  min-height: 102rpx;
  flex-shrink: 0;
}
.axis {
  width: 62rpx;
  flex-shrink: 0;
  text-align: center;
}
.month {
  align-self: center;
  font-size: 21rpx;
  color: #929b95;
}
.day {
  flex: 1;
  min-width: 0;
  text-align: center;
}
.day-today {
  background: #eaf1e9;
  border-radius: 12rpx;
}
.day-today .weekday,
.day-today .date {
  color: #426b50;
  font-weight: 500;
}
.weekday {
  font-size: 20rpx;
  color: #9aa29d;
}
.date {
  display: inline-block;
  position: relative;
  font-size: 25rpx;
  line-height: 38rpx;
  color: #53635b;
  font-weight: 500;
  margin-top: 2rpx;
}
.date.active {
  color: #4a7860;
}
.today-dot {
  position: absolute;
  height: 5rpx;
  width: 5rpx;
  border-radius: 50%;
  background: #92b39b;
  bottom: -3rpx;
  left: 50%;
  margin-left: -2.5rpx;
}
.day-hint {
  display: block;
  font-size: 16rpx;
  color: #a49e88;
  line-height: 22rpx;
}
.grid-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}
.grid {
  position: relative;
  height: 1276rpx;
}
.grid-row {
  height: 116rpx;
  display: flex;
}
.grid-row .axis {
  padding-top: 12rpx;
}
.section {
  font-size: 25rpx;
  font-weight: 500;
  color: #6c7c73;
  margin-bottom: 3rpx;
}
.section-time {
  font-size: 15rpx;
  line-height: 20rpx;
  color: #b0b7b2;
  font-weight: 400;
}
.cell {
  flex: 1;
  border-top: 1rpx solid #f2f3ef;
}
.courses {
  position: absolute;
  left: 62rpx;
  right: 3rpx;
  top: 0;
}
.card {
  position: absolute;
  padding: 2rpx;
}
.card-inner {
  height: 100%;
  border-radius: 9rpx;
  padding: 10rpx 5rpx 8rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.course-name {
  font-size: 20rpx;
  font-weight: 400;
  line-height: 1.45;
  word-break: normal;
  overflow-wrap: anywhere;
  flex: 0 1 auto;
  min-height: 0;
  overflow: hidden;
}
.room {
  font-size: 16rpx;
  line-height: 1.4;
  margin-top: 7rpx;
  word-break: break-all;
  flex: 0 0 auto;
}
.badge {
  font-size: 15rpx;
  line-height: 1.3;
  margin-top: 5rpx;
  opacity: 0.7;
  flex: 0 0 auto;
}
.tight {
  padding: 6rpx 5rpx;
}
.tight .course-name {
  font-size: 20rpx;
  line-height: 1.3;
}
.tight .room {
  margin-top: 3rpx;
  font-size: 15rpx;
}
.tight .badge {
  font-size: 14rpx;
  margin-top: 2rpx;
}
.footnote {
  text-align: center;
  font-size: 19rpx;
  color: #a9b0aa;
  padding: 20rpx 12rpx;
}
.week-empty {
  text-align: center;
  padding: 12rpx;
  font-size: 22rpx;
  color: #9aa59d;
}
.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(32, 46, 38, 0.22);
  z-index: 10;
  display: flex;
  align-items: flex-end;
}
.sheet {
  background: #fcfcfa;
  border-radius: 28rpx 28rpx 0 0;
  padding: 28rpx;
  width: 100%;
  max-height: 78vh;
  overflow-y: auto;
  padding-bottom: calc(36rpx + env(safe-area-inset-bottom));
}
.sheet .title {
  font-size: 36rpx;
  font-weight: 500;
  letter-spacing: 0;
}
.sheet .line {
  font-size: 26rpx;
  border-color: #edf0eb;
}
.sheet .primary {
  background: #607f6d;
}
.adjust-parts {
  padding: 16rpx;
  background: #f0f3ee;
  border-radius: 16rpx;
}

<view class="page">
  <view class="title">{{mode === 'import' ? '导入课表' : '导出课表'}}</view>
  <view class="row"><button style="flex:1" data-mode="import" bindtap="mode">导入 JSON</button><button style="flex:1" data-mode="backup" bindtap="mode">导出 / 恢复</button></view>
  <view wx:if="{{mode === 'backup'}}" class="panel">
    <button class="primary" bindtap="export">复制课表 JSON</button>
    <button bindtap="file">分享课表文件</button>
    <text wx:if="{{exportText}}" class="muted" selectable style="word-break:break-all">{{exportText}}</text>
  </view>
  <view class="panel">
    <view class="label">{{mode === 'import' ? '粘贴课表 JSON' : '粘贴完整备份 JSON 以恢复'}}</view>
    <textarea value="{{text}}" maxlength="2000000" placeholder="粘贴 JSON" bindinput="input" />
    <button wx:if="{{mode === 'import'}}" bindtap="example">填入示例</button>
    <button class="primary" bindtap="validate">校验并预览</button>
    <view wx:if="{{message}}" class="notice">{{message}}</view>
  </view>
  <view wx:if="{{preview}}" class="panel">
    <view class="preview-title">{{count}} 条课程 · {{adjustmentCount}} 条调整</view>
    <view wx:for="{{rows}}" wx:key="index" class="line"><view>{{item.name}} · {{item.room || '教室待定'}}</view><view class="muted">周{{item.day}} · 第 {{item.sections}} 节 · 第 {{item.weeks}} 周</view></view>
    <button class="primary" bindtap="confirm">确认替换课表</button>
  </view>
</view>

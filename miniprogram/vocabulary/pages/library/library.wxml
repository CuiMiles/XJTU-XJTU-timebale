<view class="page"><view class="title">词库</view><input placeholder="搜索英文词头或变体" value="{{query}}" bindinput="input" maxlength="100"/><view class="row"><picker range="{{levels}}" value="{{levelIndex}}" bindchange="levelPick"><view class="picker">{{levels[levelIndex]}} ▾</view></picker><picker range="{{filters}}" value="{{filterIndex}}" bindchange="filterPick"><view class="picker">{{filters[filterIndex]}} ▾</view></picker></view><view class="muted">找到 {{count}} 词 · 分层尚未作课标审核</view>
<view wx:if="{{loadError}}" class="notice">{{loadError}}</view><button wx:if="{{undoAvailable}}" bindtap="undo">撤销刚才的“熟”</button>
<view wx:for="{{rows}}" wx:key="id" class="panel row"><view class="word-summary" data-id="{{item.id}}" bindtap="open"><view class="word">{{item.word}}</view><view class="muted">{{item.level}} {{item.deep ? '· 五步深学' : ''}} ›</view></view><button size="mini" data-id="{{item.id}}" bindtap="star">{{item.favorite ? '★' : '☆'}}</button><button size="mini" data-id="{{item.id}}" bindtap="known">{{item.familiar ? '重学' : '熟'}}</button></view>
<view wx:if="{{!rows.length && !loadError}}" class="empty">暂无词条，试试其他条件。</view><button wx:if="{{rows.length < count}}" bindtap="more">加载更多</button></view>

<view class="page"><view wx:if="{{loading}}" class="empty">正在准备词条…</view><view wx:elif="{{loadError}}" class="notice">{{loadError}}<button bindtap="refresh">重试</button></view><block wx:else><view class="panel"><word-card entry="{{entry}}" bindsense="sense" bindlookup="lookup"/></view><view class="row"><button bindtap="known">{{familiar ? '重新学习' : '熟 · 跳过此词'}}</button><button bindtap="star">{{favorite ? '★ 已收藏' : '☆ 收藏'}}</button></view><button wx:if="{{undoAvailable}}" bindtap="undo">撤销刚才的操作</button><button bindtap="ask">对这个词提问</button></block></view>
<view wx:if="{{lookupWord}}" class="lookup-mask"><view class="lookup-sheet"><view class="title">{{lookupWord}}</view><view class="line">{{lookupLoading ? '查词中…' : lookupDefinition}}</view><button bindtap="closeLookup">返回原词</button></view></view>

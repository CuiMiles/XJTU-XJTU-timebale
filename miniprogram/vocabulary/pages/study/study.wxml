<view class="page"><view wx:if="{{loading}}" class="empty">正在准备词卡…</view><view wx:elif="{{loadError}}" class="notice">{{loadError}}<button bindtap="initialize">重新加载</button></view>
<view wx:elif="{{done}}" class="panel empty"><view class="title">今天这一轮，完成了</view><view class="line">新学 {{stats.daily.newIds.length}} 词 · 复习 {{stats.daily.reviewIds.length}} 词</view><view class="muted">{{stats.daily.attempts}} 次记忆反馈 · {{stats.familiar}} 个熟词</view><button class="primary" bindtap="finish">完成</button></view>
<block wx:else><view class="row"><text class="muted">{{mode}} · 剩余 {{remaining}} 张</text><text class="link" bindtap="toggleSpelling">{{spellingMode ? '切换回忆' : '练习拼写'}}</text></view>
<view wx:if="{{!answer}}" class="panel recall"><block wx:if="{{spellingMode}}"><view class="line">{{prompt}}</view><input value="{{spellingText}}" bindinput="spellingInput" placeholder="输入英文词头" maxlength="100"/><button bindtap="checkSpelling">检查拼写</button></block><block wx:else><view class="headword">{{headword}}</view><view class="muted">先想想英文含义，再看释义。</view></block><button class="primary" bindtap="reveal">看英文释义</button></view>
<view wx:if="{{spellingResult}}" class="notice">{{spellingResult}} · 拼写记录不改变复习日期</view>
<view wx:if="{{answer}}" class="panel"><word-card entry="{{entry}}" bindsense="sense" bindlookup="lookup"/></view>
<view class="row"><button disabled="{{busy}}" bindtap="known">熟 · 跳过此词</button><button wx:if="{{answer}}" bindtap="star">{{favorite ? '★ 已收藏' : '☆ 收藏'}}</button><button wx:if="{{answer}}" bindtap="ask">提问</button></view>
<view wx:if="{{answer}}" class="ratings"><button disabled="{{busy}}" data-rating="unknown" bindtap="rate">不认识</button><button disabled="{{busy}}" data-rating="fuzzy" bindtap="rate">模糊</button><button disabled="{{busy}}" class="primary" data-rating="known" bindtap="rate">认识</button></view>
</block><button wx:if="{{undoAvailable}}" bindtap="undo">撤销刚才的“熟”</button><view class="muted">每张词卡完成即保存，可随时返回。</view></view>
<view wx:if="{{lookupWord}}" class="lookup-mask"><view class="lookup-sheet"><view class="title">{{lookupWord}}</view><view class="line">{{lookupLoading ? '查词中…' : lookupDefinition}}</view><button bindtap="closeLookup">返回原词</button></view></view>
